APP_NAME=SIMANDA
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Makassar
APP_URL=https://simanda.example.com

DB_CONNECTION=sqlite
DB_DATABASE=/var/www/simanda/database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

CACHE_STORE=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAYS=14

SIMANDA_BACKUP_PATH=/var/backups/simanda
SIMANDA_BACKUP_DAILY_KEEP=7
SIMANDA_BACKUP_WEEKLY_KEEP=4
SIMANDA_BACKUP_MONTHLY_KEEP=6

SIMANDA_ALERT_START_DAYS=7
SIMANDA_ALERT_END_DAYS=7
SIMANDA_ALERT_VERIFICATION_DAYS=3
SIMANDA_ALERT_REVISION_DAYS=3
SIMANDA_ALERT_DRAFT_DAYS=3
SIMANDA_DISK_WARNING_PERCENT=15
